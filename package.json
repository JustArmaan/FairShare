{
  "name": "app",
  "version": "0.0.1",
  "scripts": {
    "dev": "nodemon -e ts,tsx,html -w src -x bun run src/server/main.tsx",
    "start": "bun src/server/main.tsx",
    "build": "vite build",
    "tailwind-watch": "bun x tailwindcss -i ./src/server/views/tailwind.css -o ./public/output.css --watch",
    "tailwind-build": "bun x tailwindcss -i ./src/server/views/tailwind.css -o ./public/output.css",
    "generate": "drizzle-kit generate",
    "seed": "bun run src/server/database/seed.ts",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "turso-local": "turso dev",
    "db-setup": "bun run generate && bun run push && bun run seed && echo 'Database Initialized!'",
    "typecheck": "tsc --noEmit",
    "local-tunnel": "lt --port 3000"
  },
  "typings": "/index.d.ts",
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@kinde-oss/kinde-typescript-sdk": "^2.13.0",
    "@libsql/client": "^0.5.6",
    "@types/cookie": "^1.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/google.maps": "^3.58.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/react": "^18.3.28",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.7.0",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "heic2any": "^0.0.4",
    "htmx.org": "^1.9.12",
    "jsxte": "^3.3.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-html-parser": "^6.1.13",
    "nodemon": "^3.1.14",
    "open": "^10.2.0",
    "patch-package": "^8.0.1",
    "react": "^18.3.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-hamburgers": "^1.4.0",
    "tsx": "^4.21.0",
    "uuid": "^9.0.1",
    "vite": "^5.4.21",
    "vite-express": "^0.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/connect-livereload": "^0.6.3",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/googlemaps": "^3.43.3",
    "@types/livereload": "^0.9.5",
    "@types/mime": "^4.0.0",
    "@types/node": "^20.19.33",
    "bun-types": "latest",
    "tailwindcss": "^3.4.19",
    "vite-plugin-pwa": "^0.20.5"
  },
  "module": "src/index.js",
  "type": "module",
  "peerDependencies": {
    "typescript": "^5.5.3"
  }
}
